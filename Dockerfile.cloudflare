# Cloudflare Containers build for the BEAT admin dashboard (Next.js 16)
FROM node:22-slim AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@latest --activate && pnpm install --frozen-lockfile
COPY . .
# NEXT_PUBLIC_API_URL is baked at build time from .env.production
RUN pnpm build

FROM node:22-slim
WORKDIR /app
COPY --from=build /app ./
EXPOSE 3000
ENV PORT=3000
CMD ["npx", "next", "start", "-p", "3000"]
